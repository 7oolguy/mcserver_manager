# Copy to service.env on the chosen service host. Never commit the real file.
BEC_PANEL_URL=https://your-hosting-panel.example
BEC_SERVER_ID=your-server-id
BEC_GAME_HOST=your-minecraft-host.example
BEC_GAME_PORT=25565
BEC_SFTP_HOST=your-minecraft-host.example
BEC_SFTP_PORT=2022
BEC_SFTP_USER=your-sftp-user
BEC_HOST_SHA256=your-verified-64-character-sftp-fingerprint
BEC_API_KEY=your-hosting-client-api-key
BEC_SFTP_PASSWORD=your-sftp-password
